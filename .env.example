# AI PAJAK - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# AI Services
# ===========================================
# OpenAI - For GPT-4 Vision OCR and Chat
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic - For Claude Chat Assistant
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Google Cloud - For Vision OCR
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key

# ===========================================
# Payment - Midtrans
# ===========================================
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_MERCHANT_ID=your-merchant-id

# ===========================================
# DJP Integration (Indonesian Tax Authority)
# ===========================================
DJP_API_URL=https://api.pajak.go.id
DJP_API_KEY=your-djp-api-key
DJP_API_SECRET=your-djp-api-secret

# ===========================================
# Application Configuration
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# Security
# ===========================================
# 2FA Secret Encryption Key (generate with: openssl rand -base64 32)
TWO_FACTOR_ENCRYPTION_KEY=your-32-byte-encryption-key

# Session Secret
SESSION_SECRET=your-session-secret

# ===========================================
# Email (Resend - for notifications)
# ===========================================
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=AI Pajak <noreply@aipajak.com>
EMAIL_SUPPORT=support@aipajak.com

# ===========================================
# Cron Jobs (Vercel Cron)
# ===========================================
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-key

# ===========================================
# Rate Limiting (Upstash Redis)
# ===========================================
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ===========================================
# Error Tracking (Sentry)
# ===========================================
# Get these from https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=ai-pajak
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ===========================================
# Bank Integration (Brick - Open Banking)
# ===========================================
# Get these from https://dashboard.onebrick.io
BRICK_API_URL=https://api.onebrick.io/v2
BRICK_PUBLIC_KEY=your-brick-public-key
BRICK_SECRET_KEY=your-brick-secret-key

# ===========================================
# Jurnal.id (Mekari) Integration
# ===========================================
# Get these from https://api-doc.jurnal.id
JURNAL_CLIENT_ID=your-jurnal-client-id
JURNAL_CLIENT_SECRET=your-jurnal-client-secret
JURNAL_REDIRECT_URI=http://localhost:3000/api/integrations/jurnal/callback

# ===========================================
# Accurate Online Integration
# ===========================================
# Get these from https://account.accurate.id/developer
ACCURATE_CLIENT_ID=your-accurate-client-id
ACCURATE_CLIENT_SECRET=your-accurate-client-secret
ACCURATE_REDIRECT_URI=http://localhost:3000/api/integrations/accurate/callback

# ===========================================
# Testing
# ===========================================
TEST_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
