# ============================================================================
# AI PAJAK — 새 개발자용 로컬 개발 환경 템플릿
# ----------------------------------------------------------------------------
# 사용법:  cp .env.local.example .env.local  후, 아래 안내에 따라 값 채우기.
#
# 키를 [출처]로 분류했습니다:
#   🟢 자동   — 로컬 Supabase(`supabase start`)가 생성. 요청 불필요.
#   🔵 본인   — 각자 본인 계정에서 발급(dev용). 요청 불필요, 권장.
#   🟡 요청   — 해당 기능을 직접 만질 때만 팀 소유자에게 안전 채널로 요청.
#   ⚪ 선택   — 없어도 됨. 비우면 해당 기능만 mock/graceful-degrade.
#
# ⚠️ 절대 프로덕션 Supabase 주소를 넣지 말 것. 로컬/개발 DB만.
# ⚠️ 이 파일(.env.local)은 .gitignore로 커밋 차단됨 — 유지할 것.
# ⚠️ 키는 카톡/이메일 평문 금지. onetimesecret.com 또는 1Password 등으로 전달.
# ============================================================================

# ===========================================
# 🟢 자동 — 로컬 Supabase (요청 불필요)
# ===========================================
# `supabase start` 실행 후 출력되는 값을 그대로 붙여넣으세요.
#   API URL       → NEXT_PUBLIC_SUPABASE_URL
#   anon key      → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   service_role  → SUPABASE_SERVICE_ROLE_KEY
# (별도 공용 dev Supabase 프로젝트를 쓰는 경우에만 소유자에게 요청 = 🟡)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase start 출력값>
SUPABASE_SERVICE_ROLE_KEY=<supabase start 출력값>

# ===========================================
# 🔵 본인 발급 — AI 서비스 (dev용은 본인 키 권장)
# ===========================================
# 본인 계정에서 발급하면 격리·비용관리에 유리. 팀 키 요청 불필요.
#   Anthropic: https://console.anthropic.com/  (OCR/AI 파싱/챗봇)
#   OpenAI:    https://platform.openai.com/     (Vision OCR 보조)
ANTHROPIC_API_KEY=sk-ant-<본인 키>
OPENAI_API_KEY=sk-<본인 키>
# ⚪ Google Vision — 선택(대체 OCR). 없으면 Anthropic/OpenAI로 동작.
GOOGLE_CLOUD_API_KEY=

# ===========================================
# ⚪ 결제 — Midtrans (비우면 결제 graceful-degrade)
# ===========================================
# 결제 흐름을 직접 만질 때만 🟡 sandbox 키를 소유자에게 요청.
# 비워두면 PENDING_PAYMENT만 남고 나중에 재시도 가능(개발엔 지장 없음).
# MIDTRANS_IS_PRODUCTION 은 반드시 false 유지(실결제 방지).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# ===========================================
# 앱 기본 (그대로 두면 됨)
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ===========================================
# 🔵 본인 생성 — 보안 시크릿 (로컬용 아무 값이나 생성)
# ===========================================
# 로컬에서는 직접 생성해서 넣으면 됩니다(팀 값과 같을 필요 없음).
#   openssl rand -base64 32   → TWO_FACTOR_ENCRYPTION_KEY
#   openssl rand -hex 32      → SESSION_SECRET / CRON_SECRET
TWO_FACTOR_ENCRYPTION_KEY=<openssl rand -base64 32>
SESSION_SECRET=<openssl rand -hex 32>
CRON_SECRET=<openssl rand -hex 32>

# ===========================================
# ⚪ 이메일 — Resend (비우면 이메일 발송 스킵)
# ===========================================
# 알림 이메일을 실제로 보낼 때만 🟡 요청. 개발 대부분은 불필요.
RESEND_API_KEY=
EMAIL_FROM=AI Pajak <noreply@aipajak.com>
EMAIL_SUPPORT=support@aipajak.com

# ===========================================
# ⚪ 레이트리밋 — Upstash Redis (비우면 인메모리 폴백)
# ===========================================
# 없어도 로컬 개발 동작. 실제 레이트리밋 검증 시에만 🟡 요청 또는 본인 발급.
#   https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===========================================
# ⚪ 에러 추적 — Sentry (로컬은 비워도 됨)
# ===========================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=ai-pajak
SENTRY_AUTH_TOKEN=

# ===========================================
# ⚪ 외부 연동 — 전부 선택 (해당 기능 작업 시에만 🟡 요청)
# ===========================================
# DJP/Coretax(세무당국), Brick(오픈뱅킹), Jurnal/Accurate(회계), PSrE(전자서명).
# 비워두면 해당 연동만 비활성 — 나머지 개발엔 지장 없음.
DJP_API_URL=
DJP_API_KEY=
DJP_API_SECRET=
BRICK_API_URL=
BRICK_PUBLIC_KEY=
BRICK_SECRET_KEY=
JURNAL_CLIENT_ID=
JURNAL_CLIENT_SECRET=
JURNAL_REDIRECT_URI=http://localhost:3000/api/integrations/jurnal/callback
ACCURATE_CLIENT_ID=
ACCURATE_CLIENT_SECRET=
ACCURATE_REDIRECT_URI=http://localhost:3000/api/integrations/accurate/callback
PRIVY_API_KEY=
PRIVY_MERCHANT_KEY=
PRIVY_ENV=sandbox
VIDA_CLIENT_ID=
VIDA_CLIENT_SECRET=
VIDA_ENV=sandbox

# ============================================================================
# 최소 시작 세트 (이것만으로 npm run dev + 로그인 가능):
#   🟢 SUPABASE 3개 (supabase start 출력)
#   🔵 ANTHROPIC_API_KEY, OPENAI_API_KEY (본인 발급)
#   🔵 TWO_FACTOR_ENCRYPTION_KEY, SESSION_SECRET, CRON_SECRET (openssl 생성)
# 나머지는 전부 비워도 로컬 개발 가능. → 소유자에게 요청할 키: 원칙적으로 0개.
# ============================================================================
