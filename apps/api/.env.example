# AI Pajak API - Environment Variables
# Copy this file to .env and update values as needed

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_pajak?schema=public"

# Redis Configuration (Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # 프로덕션에서 사용
# REDIS_DB=0       # 기본 DB 번호

# PaddleOCR Service Configuration
PADDLEOCR_SERVICE_URL=http://localhost:8080
PADDLEOCR_TIMEOUT_MS=30000

# Gemini Fallback Configuration
# Used when PaddleOCR confidence is below threshold
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_FALLBACK_THRESHOLD=0.85
GEMINI_TIMEOUT_MS=30000
GEMINI_MODEL=gemini-3.0-flash

# File Upload Configuration
# TODO: Epic 10 (Production Deployment)에서 S3로 마이그레이션 예정
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
