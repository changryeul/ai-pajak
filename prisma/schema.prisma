// =====================================================
// Prisma Schema for AI-Pajak
// DB: PostgreSQL
// Prisma: v5.x
// =====================================================
//
// DELETION POLICY:
// - Cascade: Child records deleted with parent (cache, logs, dependent data)
// - Restrict: Prevent deletion if children exist (core business entities)
// - SetNull: Clear FK when parent deleted (optional references like preparedBy)
//
// Default: Restrict (explicit Cascade/SetNull where appropriate)
// =====================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ===================== ENUMS =====================
//

enum TaxType {
  PPh21
  PPh23
  VAT
  ANNUAL
}

enum WorkflowStage {
  UPLOADED
  AI_ANALYZED
  HUMAN_REVIEW
  APPROVED
  FILED
}

enum SenderType {
  HUMAN
  AI
}

enum FilingStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

// Phase 2 Enums
enum SubmissionPrepStatus {
  GENERATED
  VALIDATED
  READY_TO_FILE
  MANUALLY_SUBMITTED
  VALIDATION_FAILED
}

enum EfakturStatus {
  GENERATED
  DOWNLOADED
  UPLOADED
}

enum OcrEngine {
  PADDLEOCR
  GEMINI
  MANUAL
}

//
// ===================== CORE =====================
//

model User {
  id        BigInt   @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  companyUsers CompanyUser[]
  auditLogs    AuditLog[]   @relation("AuditActor")
  reviews      HumanReview[]

  // Phase 2 Relations
  preparedSubmissions SubmissionPrep[]  @relation("PreparedSubmissions")
  uploadedBpes        BpeDocument[]     @relation("UploadedBpes")
  customerPoas        PowerOfAttorney[] @relation("CustomerPoas")
}

model Company {
  id        BigInt   @id @default(autoincrement())
  name      String
  npwp      String   @unique
  createdAt DateTime @default(now())

  users    CompanyUser[]
  taxCases TaxCase[]

  // Phase 2 Relations
  poas PowerOfAttorney[]
}

model CompanyUser {
  companyId BigInt
  userId    BigInt
  role      String
  joinedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([companyId, userId])
}

//
// ===================== TAX CASE =====================
//

model TaxCase {
  id        BigInt   @id @default(autoincrement())
  companyId BigInt
  taxType   TaxType
  period    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  company   Company       @relation(fields: [companyId], references: [id])
  workflow  WorkflowState?
  aiResults AIResult[]
  reviews   HumanReview[]
  filings   TaxFiling[]
  messages  Communication[]
  audits    AuditLog[]

  // Phase 2 Relations
  documents      Document[]
  submissionPrep SubmissionPrep?
  bpeDocuments   BpeDocument[]
  efakturFiles   EfakturFile[]
  billingPrep    BillingPrep?
}

model WorkflowState {
  taxCaseId BigInt @id
  stage     WorkflowStage
  updatedAt DateTime @updatedAt

  taxCase TaxCase @relation(fields: [taxCaseId], references: [id])
}

//
// ===================== AI / REVIEW =====================
//

model AIResult {
  id           BigInt   @id @default(autoincrement())
  taxCaseId    BigInt
  suggestedTax String
  confidence   Float    // @deprecated Use confidenceScore for Phase 2+ (AI model confidence 0-1)
  rawResponse  Json
  createdAt    DateTime @default(now())

  // Phase 2 OCR Fields
  ocrEngine        OcrEngine?
  confidenceScore  Decimal?  @db.Decimal(5, 2) // OCR confidence score (0.00-100.00)
  processingTimeMs Int?
  fallbackUsed     Boolean   @default(false)

  taxCase TaxCase @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)

  @@index([taxCaseId])
  @@index([taxCaseId, ocrEngine]) // Composite index for OCR queries by TaxCase
}

model HumanReview {
  id           BigInt   @id @default(autoincrement())
  taxCaseId    BigInt
  reviewerId   BigInt
  finalTax     String
  overrideFlag Boolean  @default(false)
  reason       String?
  reviewedAt   DateTime @default(now())

  taxCase  TaxCase @relation(fields: [taxCaseId], references: [id])
  reviewer User    @relation(fields: [reviewerId], references: [id])
}

//
// ===================== FILING =====================
//

model TaxFiling {
  id            BigInt        @id @default(autoincrement())
  taxCaseId     BigInt
  filingStatus  FilingStatus
  filedBy       BigInt?
  filedAt       DateTime?
  submissionRef String?
  createdAt     DateTime @default(now())

  taxCase TaxCase @relation(fields: [taxCaseId], references: [id])
}

//
// ===================== COMMUNICATION =====================
//

model Communication {
  id         BigInt     @id @default(autoincrement())
  taxCaseId  BigInt
  senderType SenderType
  senderId   BigInt?
  message    String
  createdAt DateTime @default(now())

  taxCase TaxCase @relation(fields: [taxCaseId], references: [id])
}

//
// ===================== AUDIT =====================
//

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  taxCaseId BigInt
  actorId   BigInt?
  action    String
  createdAt DateTime @default(now())

  taxCase TaxCase @relation(fields: [taxCaseId], references: [id])
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])

  @@index([taxCaseId])
}

//
// ===================== PHASE 2: DOCUMENT =====================
//

/// Document model for file uploads and OCR processing
/// TODO: Epic 10 (Production Deployment)에서 S3로 마이그레이션 예정
/// - 현재: 로컬 uploads/ 디렉토리에 저장 (path 필드)
/// - 변경: AWS S3 버킷으로 업로드 (path → S3 URL)
/// - 참조: architecture.md#Infrastructure & Deployment - S3 Storage
model Document {
  id           BigInt   @id @default(autoincrement())
  filename     String   // 저장된 파일명 (UUID 기반)
  originalName String   // 원본 파일명
  mimeType     String   // MIME type (image/jpeg, image/png, application/pdf)
  size         Int      // 파일 크기 (bytes)
  path         String   // 현재: 로컬 파일 경로, 추후: S3 URL
  status       String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  ocrJobId     String?  // Bull Queue job ID
  taxCaseId    BigInt?
  uploadedBy   BigInt?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taxCase TaxCase? @relation(fields: [taxCaseId], references: [id])

  @@index([taxCaseId])
  @@index([status])
}

//
// ===================== PHASE 2: SUBMISSION PREP =====================
//

model SubmissionPrep {
  id                     BigInt               @id @default(autoincrement())
  taxCaseId              BigInt               @unique
  sptData                Json
  operatorHelperData     Json?
  status                 SubmissionPrepStatus @default(GENERATED)
  validatedAt            DateTime?
  validationErrors       Json?
  preparedByConsultantId BigInt?
  manuallySubmittedAt    DateTime?
  djpReferenceId         String?              @db.VarChar(100)
  createdAt              DateTime             @default(now())

  taxCase    TaxCase @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  preparedBy User?   @relation("PreparedSubmissions", fields: [preparedByConsultantId], references: [id], onDelete: SetNull)

  @@index([taxCaseId])
  @@index([status])
}

//
// ===================== PHASE 2: BPE DOCUMENTS =====================
//

model BpeDocument {
  id                     BigInt    @id @default(autoincrement())
  taxCaseId              BigInt
  bpeNumber              String?   @unique @db.VarChar(50)
  fileUrl                String
  fileSize               Int?
  uploadedByConsultantId BigInt?
  uploadedAt             DateTime
  sentToCustomerAt       DateTime?
  createdAt              DateTime  @default(now())

  taxCase    TaxCase @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation("UploadedBpes", fields: [uploadedByConsultantId], references: [id], onDelete: SetNull)

  @@index([taxCaseId])
}

//
// ===================== PHASE 2: EFAKTUR FILES =====================
//

model EfakturFile {
  id                 BigInt        @id @default(autoincrement())
  taxCaseId          BigInt
  fileUrl            String
  status             EfakturStatus @default(GENERATED)
  downloadedAt       DateTime?
  manuallyUploadedAt DateTime?
  djpReferenceId     String?       @db.VarChar(100)
  createdAt          DateTime      @default(now())

  taxCase TaxCase @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)

  @@index([taxCaseId])
  @@index([status])
}

//
// ===================== PHASE 2: BILLING PREP =====================
//

model BillingPrep {
  id          BigInt    @id @default(autoincrement())
  taxCaseId   BigInt    @unique
  billingData Json
  amount      Decimal   @db.Decimal(15, 2)
  ntpn        String?   @db.VarChar(50)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  taxCase TaxCase @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)

  @@index([taxCaseId])
}

//
// ===================== PHASE 2: POA (POWER OF ATTORNEY) =====================
//

model PowerOfAttorney {
  id          BigInt    @id @default(autoincrement())
  customerId  BigInt    // User who granted POA (customer)
  companyId   BigInt
  startDate   DateTime
  endDate     DateTime
  documentUrl String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer        User                 @relation("CustomerPoas", fields: [customerId], references: [id])
  company         Company              @relation(fields: [companyId], references: [id])
  validationCache PoaValidationCache[]

  @@index([customerId])
  @@index([companyId])
  @@index([endDate])
}

model PoaValidationCache {
  id                BigInt    @id @default(autoincrement())
  poaId             BigInt
  validatedAt       DateTime
  isValid           Boolean
  expiryWarningSent Boolean   @default(false)
  nextValidationAt  DateTime?
  createdAt         DateTime  @default(now())

  poa PowerOfAttorney @relation(fields: [poaId], references: [id], onDelete: Cascade)

  @@index([poaId])
}